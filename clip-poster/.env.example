# ── Copy this file to ".env" and fill in the blanks ──────────────

# Your Render server (leave as-is unless the URL changed)
SERVER_WS=wss://mackinac-ship-tracker.onrender.com
SERVER_HTTP=https://mackinac-ship-tracker.onrender.com

# OBS WebSocket — from OBS: Tools ▸ WebSocket Server Settings
# (enable the server, then "Show Connect Info" for the port + password)
OBS_URL=ws://127.0.0.1:4455
OBS_PASSWORD=

# Anthropic key for Haiku-written titles (same key the server uses)
ANTHROPIC_API_KEY=

# Where finished clips land
OUTPUT_DIR=./clips

# A bold TTF font for the burned-in caption (Windows default shown)
FONT_FILE=C:/Windows/Fonts/arialbd.ttf

# ── Tuning (sensible defaults; adjust after you see real clips) ──
CLIP_SECONDS=32          # length of each Short (OBS replay buffer must be >= this)
SAVE_DELAY_MS=6000       # wait this long after a passing before saving, so the
                         # crossing sits near the end of the clip, not the very edge
CLIP_TRIM_START=0        # seconds to skip from the START of each clip (raise to trim dead air up front)
FG_WIDTH_PCT=0.92        # (pad style only) boat-band width vs full frame; lower if phones still crop the sides, 1 = full width
CLIP_STYLE=pad           # 'pad' = blurred bars, nothing cropped | 'zoom' = zoomed in on a blurred background
CLIP_ZOOM=1.5            # (zoom style) 1 = full width, higher = bigger subject + more side crop, lower = more scene + more blur
CLIP_PAN_X=0             # (zoom style) horizontal shift in px: + moves the picture RIGHT, - moves it LEFT
CLIP_START_HOUR=6        # only clip between these local hours; 6–24 = 6:00am to 11:59pm
CLIP_END_HOUR=24         # (skips the dark overnight; you review each clip before publishing)
AMBIENT_VOLUME=0.30      # live engine/water sound level under the narration
NARRATION_VOLUME=1.40    # narration voice level

# ── YouTube auto-posting (Phase 2 — see POSTING-SETUP.md) ────────
YT_ENABLED=0             # set to 1 AFTER you've run "node youtube-auth.js" successfully
POST_EACH=0              # 0 = post best 2/day (morning + evening) | 1 = upload EVERY clip as private (you publish the good ones)
YT_PRIVACY=private       # uploads land private (you tap Publish). 'public' only works after Google's audit
YT_CATEGORY=19           # 19 = Travel & Events
YT_PLAYLIST=             # playlist ID (the part after list= in the playlist URL) — every Short gets auto-added here
MORNING_SLOT=08:30       # local time to post the best overnight/morning clip
EVENING_SLOT=18:30       # local time to post the best daytime clip
LIVE_URL=                # your 24/7 livestream URL — appended as a CTA at the end of every description
